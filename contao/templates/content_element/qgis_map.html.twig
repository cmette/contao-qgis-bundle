{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_map.html.twig' %}
{% use '@Contao/component/_handler.js.twig' %}
{% use '@Contao/component/_olext.js.twig' %}
{% use '@Contao/component/_featurelist.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <!-- link rel="stylesheet" href="{{ asset('bundles/contaoqgisbundle/css/qgis.css') }}" -->
{% endblock %}

{% set content_layout_attributes = attrs()
    .addClass('media media--' ~ layout, layout and image)
    .mergeWith(content_layout_attributes|default)
%}

{#
    By default we add the layout attributes to the wrapper element. If you want to
    disable this behavior, set "default_content_layout" to false.
#}
{% set map_attributes = attrs(attributes|default)
    .set('id', "olmap-" ~ (map ? map.id : 0))
    .addClass('map')
    .mergeWith(content_layout_attributes, default_content_layout is not defined or default_content_layout)
%}

{# Media #}
{% block text_media %}
    {% if image %}
        {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if layout != 'below' %}
        {{ block('text_media') }}
    {% endif %}

    {% block text %}
        <style>
            .ol-control.ol-layerswitcher {
                right: 2rem;
                top: 0.5rem;
                box-shadow: 0 3px 14px rgba(0,0,0,0.4);
                opacity: 0.8;
            }
            .ol-control.ol-layerswitcher .panel-container {
                margin: 0;
                padding: 4px;
            }
            .ol-layerswitcher .layerInfo {
                display: none !important;
            }
            .ol-layerswitcher [type="checkbox"]:checked + label {
            //display: none;
            }
            .ol-layerswitcher .layerswitcher-opacity-label {
                bottom: 50%;
            }
            ul.panel > li {
                background-color: #f0f0f0;
                margin-bottom: 4px;
            }
            li.ol-header {
                display: none !important;
            }
        </style>
        {% if map %}
            <p>Halten Sie Shift + Alt gedrückt und ziehen Sie die Maus über die Karte, um die Karte zu drehen. {# {page::alias} #}</p>
            <div class="map-wrapper">
                <div{{- map_attributes -}}>
                    <div id="map_{{ map.id }}_coords"></div>
                    <div id="map_{{ map.id }}_scope">[{{ scope ? 'backend':'frontend' }}]</div>

                    {# {- block('popup_component') -} #}
                    <div id="popup" class="ol-popup">
                        <!-- a href="#" id="popup-closer" class="ol-popup-closer"></a -->
                        <div id="popup-content"></div>
                    </div>
                </div>
                <div class="list">
                    {% set cond1 = data.addFeatureList %}
                    {% set cond2 = featureLayer.published %}
                    {# set cond3 = map.getLayer(featureLayer.id)._enable #}
                    {% set cond = (data.addFeatureList and featureLayer.published and map.getLayer(featureLayer.id)._enable) %}
                    {% if (cond) %}
                    <div id="map-{{ map.id }}-feature-list">
                        {{ listHeadline|raw }}
                        {{ block('featurelist_component') }}
                    </div>
                    {% endif %}
                    <div>{{ data.text|raw }}</div>
                </div>
            </div>
            <script type="text/javascript">
                {{ block('map_component') }}
                {{ block('handler_component') }}
                {{ block('olext_component') }}
            </script>
        {% else %}
            <div>{{- 'tl_sources_entity.source_not_found'|trans([], 'contao_tl_sources_entity') -}}</div>
        {% endif %}
    {% endblock %}

    {% if layout == 'below' %}
        {{ block('text_media') }}
    {% endif %}

{% endblock %}