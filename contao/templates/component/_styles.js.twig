{% trans_default_domain "tl_qgis_map" %}
{#
    lädt alle Styles einer Karte und die von ihnen verwendeten Code-Teile
#}

{% block styles_component %}
//-- olmap-{{ map.id }} Styles -----------------------------------------------
function mm2px(m) {
    // mittlerer Pixelabstand berechnen (units pro Pixel)
    const _map = map_{{- map.id -}};

    const centerCoord = _map.getView().getCenter();
    const centerPx = _map.getPixelFromCoordinate(centerCoord);
    const rightPx = [centerPx[0] + 100, centerPx[1]]; // 100 px Abstand
    const coordC = _map.getCoordinateFromPixel(centerPx);
    const coordR = _map.getCoordinateFromPixel(rightPx);
    const line = new ol.geom.LineString([coordC, coordR]);
    const unitsPer100px = line.getLength(); // Länge in Karten-Einheiten für 100 px
    if (!unitsPer100px || unitsPer100px === 0) return 0;
    const unitsPerPx = unitsPer100px / 100;
    return Math.ceil(m / unitsPerPx); // px für m Einheiten
}

/**
 * Der styleCache aggregiert alle auf der Karte verwendeten
 * Styles für einen schnelleren Zugriff.
 */
map_{{- map.id -}}_styleCache = {
    {% set usedstyles = map.getAllStyles() %}
    {%- for id,style in usedstyles -%}
//-- {{ style.name|raw }} --
    //style_{{ style.id }}: new ol.style.Style({
    style_{{ style.id }}: (feature) => new ol.style.Style({
        stroke: new ol.style.Stroke({
            color:    '{{ style.getRgba('stroke')|raw }}',
            lineDash: {{ style.lineDash|raw }},
            lineCap:  '{{ style.lineCap|raw }}',
            lineJoin: '{{ style.lineJoin|raw }}',
            //width: mm2px(1.26), ToDo: funktioniert nicht wg. Refernzfehler zur Laufzeit
            width: {{ style.width }},
        }),
        fill:   new ol.style.Fill({ color: '{{ style.getRgba('fill')|raw }}' }),
        image:  new ol.style.Circle({ radius: 6, fill: new ol.style.Fill({ color: '#ff0' }) }),
        text:   new ol.style.Text({
            font: '12px Calibri,sans-serif',// string, CSS font string, z.B. '12px Calibri,sans-serif'
            text: feature.get('name'),      // string, zu zeichnender Text
            textAlign: 'center',            // 'left' | 'right' | 'center' | 'start' | 'end',
            textBaseline: 'top',            // 'top' | 'middle' | 'bottom' | 'alphabetic' | 'hanging' | 'ideographic',
            offsetX: 0,                     // number, Pixel-Verschiebung in X
            offsetY: 0,                     // number, Pixel-Verschiebung in Y
            rotation: 0,                    // number, Rotation in Radiant
            //scale: 5,                       // number, Skalierung (number) — alternativ use scale/size in newer OL?
            //fill: null,                     // ol.style.Fill({}) oder null
            //stroke: null,                   // ol.style.Stroke({}) oder null
            //backgroundFill: null,           // ol.style.Fill({}) Hintergrundfüllung für Text
            //backgroundStroke: null,         // ol.style.Stroke({}) Hintergrund-Stroke für Text
            //padding: [],                    // array [top, right, bottom, left] in px
            placement: 'point',               // 'point' | 'line',// 'line' für entlang Linien (nur bei ol/style/Text)
            //maxAngle: 0,                    // number, max Winkel (rad) für placement 'line'
            //overflow: false,                // boolean, Text auch außerhalb Geometry rendern (default false)
            //rotateWithView: true,           // boolean, ob Text mit View rotiert (true/false)
        }),
    }),
    {% endfor -%}
};

/**
 *
 * @param feature
 * @param resolution
 * @returns {*|null}
 */
map_{{- map.id -}}_styleFunction = (feature, resolution) => {
    // Zugriff auf Feature-Attribute
    const style_id = feature.get('styleId');

    // Auflösung an Zoomstufen anpassen
    if (resolution > 100) {
        return null; // bei sehr geringer Zoomstufe nichts zeichnen
    }

    // Rückgabe: Style-Instanz, Array von Styles oder null
    return map_{{- map.id -}}_styleCache[`style_${style_id}`](feature);
};
{% endblock %}