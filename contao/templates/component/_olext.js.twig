{% trans_default_domain "tl_qgis_map" %}
{#
    maganged das Laden von ol-ext Komponenten
#}

{% block olext_component %}
    //-- begin ol-ext ---------------------------------------------
{% if(map.useCompass) %}
var map_{{- map.id -}}_compass;

function setCompass(c) {
    if (c) map_{{ map.id }}.removeControl(c);

    //if ($("#top").prop("checked")) {
    if (true) {
        c = new ol.control.Compass ({
            className: "top",           // string — CSS-Klasse für den Control-Container.
            visible: true,              // boolean — Sichtbarkeit (default: true).
            //visible:                  // boolean — Sichtbarkeit (default: true).
            //src: $("#image").val(),     // string — Bild-URL oder 'default' | 'compact' (wird verwendet falls image nicht gesetzt).
            src: 'compact',
            // rotateWithView:          // boolean — die Kompassgrafik mit der View rotieren (default: true).
            style: new ol.style.Stroke ({ color: '#3399cc', width: 0 }) // ol.style.Stroke — Style zum Zeichnen der Linien (wird für Text-/Linienzeichnung benutzt); standardmäßig werden keine Linien gezeichnet.
        });
        map_{{ map.id }}.addControl(c);
    }
}
setCompass(map_{{- map.id -}}_compass);
{% endif %}
    //-- end ol-ext -----------------------------------------------
{% endblock %}