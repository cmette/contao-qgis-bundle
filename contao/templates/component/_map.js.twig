{#
    rendert das map-Element der Karte
#}
{% trans_default_domain "tl_qgis_map" %}
{% use '@Contao/component/_layers.html.twig' %}
{% use '@Contao/component/_styles.html.twig' %}

{%- block map_component -%}
    //-- Map target: olmap-{{ map.id }} const: map_{{ map.id }} -----------------------------------------------

    //var size = 0;
    //var placement = 'point';

    {# konstruiert Style-Objekte und lädt nötige Code-Teile #}
    {{ block('styles_component') }}

    {# konstruiert Layers #}
    {{ block('layers_component') }}

    const map_{{- map.id -}} = new ol.Map({
        target: 'olmap-{{- map.id -}}',
        layers: ol_layers_{{- map.id -}},
        renderer: 'canvas',

        view: new ol.View({
            zoom: 16,
            //minZoom: 13,
            //maxZoom: 19,
            //center: [51.42844665110317, 13.858214471317353],
        })
    });

    //initial view - epsg:3857 coordinates if not "Match project CRS"
    map_{{- map.id -}}.getView().fit([1542151.208901, 6696831.973394, 1543390.308651, 6698068.387861], map_{{- map.id -}}.getSize());

    //full zooms only
    //map_{{- map.id -}}.getView().setProperties({constrainResolution: true});

    //-- end Map -------------------------------------------------------------------------
{%- endblock -%}