{#
    rendert das map-Element der Karte
#}
{% trans_default_domain "tl_qgis_map" %}
{% use '@Contao/component/_layers.js.twig' %}
{% use '@Contao/component/_styles.js.twig' %}

{% block map_component %}
    //-- Map target: olmap-{{ map.id }} const: map_{{ map.id }} -----------------------------------------------

    //var size = 0;
    //var placement = 'point';

    {# konstruiert alle Style-Objekte der Map und fügt nötige Code-Teile hinzu #}
    {{ block('styles_component') }}

    {# konstruiert Layers #}
    {{ block('layers_component') }}

    map_{{ map.id }} = new ol.Map({
        target: 'olmap-{{- map.id -}}',
        layers: ol_layers_{{- map.id -}},
        renderer: 'canvas',
        //controls: ol.control.default({ attribution: false, zoom: false, rotate: false }).extent([
        //    new ol.control.ScaleLine()
        //]),

        view: new ol.View({
            zoom: {{ map.getZoom()|raw }},
            //minZoom: 13,
            //maxZoom: 19,
            //center: [51.42844665110317, 13.858214471317353],
            center: {{ map.getCenter()|raw }},   // epsg:3857
        })
    });

    {% set extent = map.getExtent() %}
{% dump(extent.mode) %}
    {%- if extent.mode == 'params' -%}
    {%- elseif extent.mode == 'layer' -%}
        {%- if extent.source == 'Tile' -%}
        {%- elseif extent.source == 'Vector' -%}
    extent = {{ extent.var }}.getSource().getExtent();
    map_{{- map.id -}}.getView().fit(extent, map_{{ map.id }}.getSize());
        {% endif %}
    {%- elseif extent.mode == 'feature' -%}
        extent = ol.proj.transformExtent({{ extent.extent|raw }},'EPSG:4326', 'EPSG:3857');
        map_{{- map.id -}}.getView().fit(extent, map_{{ map.id }}.getSize());
    {% endif %}

    //-- end Map -------------------------------------------------------------------------
{% endblock %}