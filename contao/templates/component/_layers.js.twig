{% trans_default_domain "tl_qgis_map" %}
{% use '@Contao/component/_features.js.twig' %}
{#
    baut die layersList zusammen
#}

{% block layers_component %}
    //var wms_layers = [];
    var ol_layers_{{- map.id -}} = [];

{% set layers = map.getLayers() %}
{% for layer in layers %}
//-- Layer.{{ layer.type }}.{{ layer.format }} -----------------------------------------------
    {% if layer.type == 'Vector' %}{# ------------------------ #}
    var source_{{ layer.type }}_{{ layer.id }} = new ol.source.{{ layer.source }}({attributions: '{{ layer.attribution|raw }}',});
    var format_{{ layer.type }}_{{ layer.id }} = new ol.format.{{ layer.format }}();
        {% if layer.format == 'GeoJSON' %}
        {{ block('features_component') }}
        {% endif %}

    {% elseif layer.type == 'Tile' %}{# ------------------------ #}
    var source_{{ layer.type }}_{{ layer.id }} = new ol.source.{{ layer.source }}({attributions: '{{ layer.attribution|raw }}',});
    source_{{ layer.type }}_{{ layer.id }}.setUrl('https://tile.openstreetmap.org/{z}/{x}/{y}.png');
    {% elseif layer.type == 'Image' %}{# ------------------------ #}
    var source_{{ layer.type }}_{{ layer.id }} = new ol.source.{{ layer.source }}(
        {
            attributions: '{{ layer.attribution|raw }}',
            url: '{{ layer.getImageSourceUrl()|raw }}',
            projection: 'EPSG:3857',
            //extent: ol.proj.transformExtent(extent, 'EPSG:3857','EPSG:4326'),
            imageEextent: {{ layer.image_extent|raw }},
        }
    );
    {% endif %}

    var layer_{{ layer.id }} = new ol.layer.{{- layer.type -}}({
        title: '{{ layer.title|raw }}',
        type: 'base',
        opacity: {{ layer.opacity }},
        source: source_{{ layer.type }}_{{ layer.id }},
        interactive: true,

        {% if layer.format == 'GeoJSON' %}
        declutter: false,
        style: map_{{- map.id -}}_styleFunction,
        popuplayertitle: '{{ layer.title }}',
        title: 'Vektor-Layer',
        {% else %}
        {% endif %}
    });

    layer_{{ layer.id }}.setVisible({{ layer.published?'true':'false' }});
    ol_layers_{{- map.id -}}.push(layer_{{ layer.id }});
    {% endfor %}
{% endblock %}