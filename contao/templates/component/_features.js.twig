{% trans_default_domain "tl_qgis_map" %}
{#
    lädt alle features eines layers
#}

{% block features_component %}
    /*-- begin features ---------------------------------------------*/
    {%  set features = layer.getAllFeaturesAsJson()|raw %}
    var json_{{ layer.type }}_{{ layer.id }} = {{ features|raw }};
    {#  iteriere über jedes einzelne feature. Nur dieses Vorgehen ermöglicht das nachträgliche Modifizieren des features mit set() #}
    json_{{ layer.type }}_{{ layer.id }}.features.forEach(gj => {
        {# liest das feature aus gj ein #}
        const feature = format_{{ layer.type }}_{{ layer.id }}.readFeature(gj, {dataProjection: '{{ layer.data_projection|raw }}',featureProjection: '{{ layer.feature_projection|raw }}'});
        {# füge fremdes property hinzu #}
        feature.set('styleId', gj.styleId);

        feature.setId(gj.id);   // überschreibt die interne ol feature id
        //feature.set('name', gj.name);
        {# füge feature dem Layer hinzu #}
        source_{{ layer.type }}_{{ layer.id }}.addFeature(feature);
    });
    /*-- end features -----------------------------------------------*/
{% endblock %}