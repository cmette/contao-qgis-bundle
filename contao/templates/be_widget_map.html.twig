{% use '@Contao/component/_map.js.twig' %}
{% use '@Contao/component/_handler.js.twig' %}

{% set label = generateLabel.invoke() %}

{% if label|default %}
    <h3>{{ label|raw }}{{ this.xlabel|default|raw }}</h3>
{% endif %}

{% set widget   = this %}
{% set map      = this.record %}
{% if scope is not defined %}
    {% set scope    = this.scope %}
{% endif %}
{% set olMapId = "olmap-#{widget.record.id}" %}

<div id="ctrl_{{ this.id }}" name="{{ this.name }}" class="olmap_widget{{ this.class }}">
    <div id="{{ olMapId }}">
        {% if map.showCrsBE %}<div id="map_{{ map.id }}_coords"></div>{% endif %}
        {% if map.showScopeBE %}<div id="map_{{ map.id }}_scope">[{{ this.scope ? 'backend':'frontend' }}]</div>{% endif %}
    </div>
</div>
<p class='tl_help tl_tip' data-contao--tooltips-target='tooltip'>{{ this.label }}</p>

<script type="text/javascript">
    {{ block('map_component') }}
    {{ block('handler_component') }}
    {#  { block('olext_component') } #}
</script>

{# { generateWithError.invoke(true)|raw } #}
